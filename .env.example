# Copy to .env and fill in what you need — docker-compose.yml reads every variable below with a
# fallback default, so this file (or setting these through whatever mechanism your deployment
# platform provides for environment variables) is optional, not required to start the stack.
# Everything below has a working default except the TMDB key; the app starts and runs without
# any of these set, but movie/show metadata search won't return real results without TMDB.

# --- Image ---
# Which published image/tag to run. Default pulls the latest build from main; pin to a version
# tag (e.g. 1.2.0) for a stable deploy, or point KOSMOS_IMAGE at a locally-built tag instead.
# KOSMOS_IMAGE=ghcr.io/kosmos-suite/kosmos
# KOSMOS_IMAGE_TAG=latest

# --- Networking ---
# Host port kosmos is reachable on. Default: 8080
KOSMOS_PORT=8080

# --- Database ---
# Defaults below work out of the box against the bundled db service; only change them if you
# want different credentials or need multiple kosmos instances sharing one Postgres host.
KOSMOS_DB_NAME=kosmos
KOSMOS_DB_USER=kosmos
KOSMOS_DB_PASSWORD=kosmos

# --- Storage ---
# Where Postgres data and your media library live on the host. Leave unset to use Docker-managed
# named volumes (kosmos-db / kosmos-library); set to an absolute host path (e.g. /mnt/nas/kosmos-db)
# to bind-mount instead, e.g. for NAS-backed storage or easier backups.
# KOSMOS_DB_DATA_PATH=/absolute/path/on/host
# KOSMOS_LIBRARY_PATH=/absolute/path/on/host

# If KOSMOS_LIBRARY_PATH is a bind mount, set these to your host user's `id -u`/`id -g` so files
# the app creates in your library are owned by you on the host, not by the image's default 185:0.
# Only matters for bind mounts — named volumes are fine with the defaults.
# PUID=1000
# PGID=1000

# --- Metadata sources ---
# TMDB API key — https://www.themoviedb.org/settings/api. Required for real movie/show search.
KOSMOS_METADATA_TMDB_API_KEY=

# AniDB account, only needed for hash-based anime file identification.
# Also requires a registered AniDB UDP client name/version — see kosmos-plugin-registry's
# CONTRIBUTING or the project's own AniDB registration for what that involves.
KOSMOS_METADATA_ANIDB_USERNAME=
KOSMOS_METADATA_ANIDB_PASSWORD=

# --- Misc ---
# Container timezone, affects log timestamps and any local-time display. Default: UTC
TZ=UTC
